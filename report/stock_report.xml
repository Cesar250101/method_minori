<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="method_minori.stock_report_pivot" model="ir.ui.view">
        <field name="model">method_minori.stock_report</field>
        <field name="arch" type="xml">
            <pivot string="Stock Productos" disable_linking="True">
                <field name="marca_id" type="row"/>
                <field name="product_id" type="row"/>                
                <field name="stock" type="measure"/>
                <field name="precio_venta" type="measure"/>

            </pivot>
        </field>
    </record>

    <record id="method_minori.stock_report_tree_view" model="ir.ui.view">
        <field name="name">method.minori.stock.report.tree.view</field>
        <field name="model">method_minori.stock_report</field>
        <field name="arch" type="xml">
            <tree string="Stock por marca">
                <field name="marca_id" />
                <field name="sku" />
                <field name="nombre_producto" />
                <field name="location_id" />
                <field name="stock" />
                <field name="product_categ_id" />
            </tree>
        </field>
    </record>

    <record id="method_minori.venta_report_pivot" model="ir.ui.view">
        <field name="model">method_minori.ventas_report_marcas</field>
        <field name="arch" type="xml">
            <pivot string="Ventas por Marca" disable_linking="True">
                <field name="marca_id" type="row"/>
                <field name="product_product_id" type="row"/>
                <field name="cliente_id" type="col"/>
                <field name="cantidad" type="measure"/>                
                <field name="price_subtotal" type="measure"/>
                <field name="price_subtotal_incl" type="measure"/>
                
            </pivot>
        </field>
    </record>

    <record id="method_minori.venta_marcas_propias_report_pivot" model="ir.ui.view">
        <field name="model">method_minori.report_marcas_propias</field>
        <field name="arch" type="xml">
            <pivot string="Ventas Marca Propias y Externas" disable_linking="True">
                <field name="marca_id" type="row"/>
                <field name="product_product_id" type="row"/>
                <field name="cantidad" type="measure"/>                
                <field name="neto" type="measure"/>                
                <field name="bruto" type="measure"/>
            </pivot>
        </field>
    </record>


    <record id="method_minori.stock_report_graph" model="ir.ui.view">
        <field name="model">method_minori.stock_report</field>
        <field name="arch" type="xml">
            <graph string="Point of Sale Payment Analysis">
                <field name="product_id" type="row"/>
                <field name="location_id" type="col"/>
                <field name="stock" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="method_minori.venta_report_graph" model="ir.ui.view">
        <field name="model">method_minori.ventas_report_marcas</field>
        <field name="arch" type="xml">
            <graph string="Ventas por marca">
                <field name="marca_id" type="row"/>
                <field name="price_subtotal_incl" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="method_minori.venta_report_tree" model="ir.ui.view">
        <field name="name">method.minori.ventas.report.marcas.tree</field>
        <field name="model">method_minori.ventas_report_marcas</field>
        <field name="arch" type="xml">
            <tree string="Ventas por marca" create="false" edit="false" delete="false">
                <field name="date_order"/>
                <field name="origen"/>
                <field name="marca_id"/>
                <field name="product_product_id"/>
                <field name="cliente_id"/>
                <field name="vendedor_id"/>
                <field name="cantidad" sum="Cantidad"/>
                <field name="price_subtotal" sum="Neto"/>
                <field name="price_subtotal_incl" sum="Bruto"/>
                <field name="comision" sum="Comisión"/>
            </tree>
        </field>
    </record>

    <record id="method_minori.venta_report_search" model="ir.ui.view">
        <field name="name">method.minori.ventas.report.marcas.search</field>
        <field name="model">method_minori.ventas_report_marcas</field>
        <field name="arch" type="xml">
            <search string="Ventas por marca">
                <field name="marca_id"/>
                <field name="product_product_id"/>
                <field name="cliente_id"/>
                <field name="vendedor_id"/>
                <field name="sucursal_id"/>
                <filter string="POS" name="origin_pos" domain="[('origen','=','POS')]"/>
                <filter string="Facturas" name="origin_invoice" domain="[('origen','=','Ventas')]"/>
                <separator/>
                <filter string="Agrupar por Marca" name="group_by_brand" context="{'group_by': 'marca_id'}"/>
                <filter string="Agrupar por Producto" name="group_by_product" context="{'group_by': 'product_product_id'}"/>
                <filter string="Agrupar por Cliente" name="group_by_customer" context="{'group_by': 'cliente_id'}"/>
                <filter string="Agrupar por Vendedor" name="group_by_seller" context="{'group_by': 'vendedor_id'}"/>
                <filter string="Agrupar por Sucursal" name="group_by_branch" context="{'group_by': 'sucursal_id'}"/>
                <filter string="Agrupar por Mes" name="group_by_month" context="{'group_by': 'date_order:month'}"/>
            </search>
        </field>
    </record>

    <record id="method_minori.venta_marcas_propias_report_graph" model="ir.ui.view">
        <field name="model">method_minori.report_marcas_propias</field>
        <field name="arch" type="xml">
            <graph string="Ventas marca propias y externas">
                <field name="product_product_id" type="row"/>
                <field name="es_propia" type="col"/>
                <field name="neto" type="measure"/>
            </graph>
        </field>
    </record>    

    <record id="method_minori.stock_report_graphsearch" model="ir.ui.view">
        <field name="model">method_minori.stock_report</field>
        <field name="arch" type="xml">
            <search string="Point of Sale Payment Analysis">
                <field name="product_id"/>
                <separator/>
                <field name="product_categ_id"/>
                <group expand="1" string="Group By">
                    <filter string="Categoria" name="categoria" context="{'group_by': 'product_categ_id'}"/>
                </group>
            </search>
        </field>
    </record>



