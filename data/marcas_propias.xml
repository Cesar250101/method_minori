<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="1">

        <record model="ir.module.category" id="module_proveedor_stock_category">
            <field name="name">Stock Proveedores</field>
            <field name="description">Acceso de Proveedores</field>
            <field name="sequence">20</field>
        </record>
        
        <record id="group_proveedores_marcas_user" model="res.groups">
            <field name="name">User</field>
            <field name="comment">Acceso de proveedores a su stock segun marca.</field>
            <field name="category_id" ref="module_proveedor_stock_category"/>
            <!-- <field name="users_rights" eval="[(4, ref('base.user_root'))]"/> -->

        </record>

        <record id="group_proveedores_marcas" model="res.groups">
            <field name="name">Manager</field>
            <field name="comment">Acceso al stock general</field>
            <field name="category_id" ref="module_proveedor_stock_category"/>
            <field name="users" eval="[(4, ref('base.user_root'))]"/>
            <!-- <field name="implied_ids" eval="[(4, ref('group_proveedores_marcas_user'))]"/> -->
        </record>

        <record id="minori_marcas_proveedor" model="ir.rule">
            <field name="name">Marcas Propias</field>
            <field ref="model_method_minori_stock_report" name="model_id"/>
            <field name="domain_force">[('user_id','=',user.id)]</field>
            <field name="groups" eval="[(4, ref('group_proveedores_marcas_user'))]"/>
        </record>

        <record id="minori_marcas_catalogo_proveedor" model="ir.rule">
            <field name="name">Marcas asignadas al proveedor</field>
            <field ref="model_method_minori_marcas" name="model_id"/>
            <field name="domain_force">[('user_id','=',user.id)]</field>
            <field name="groups" eval="[(4, ref('group_proveedores_marcas_user'))]"/>
        </record>

        <record id="minori_ventas_marcas_proveedor" model="ir.rule">
            <field name="name">Ventas de marcas asignadas al proveedor</field>
            <field ref="model_method_minori_ventas_report_marcas" name="model_id"/>
            <field name="domain_force">[('user_id','=',user.id)]</field>
            <field name="groups" eval="[(4, ref('group_proveedores_marcas_user'))]"/>
        </record>

        <!-- El informe SQL consolida datos de todas las compañías. Restringirlo
             a la compañía activa evita mezclar ventas y sucursales entre ellas. -->
        <record id="minori_ventas_marcas_company_rule" model="ir.rule">
            <field name="name">Ventas por marca de la compañía activa</field>
            <field ref="model_method_minori_ventas_report_marcas" name="model_id"/>
            <field name="domain_force">[('company_id', '=', company_id)]</field>
        </record>

        <record id="minori_ventas_marcas_propias_proveedor" model="ir.rule">
            <field name="name">Ventas propias asignadas al proveedor</field>
            <field ref="model_method_minori_report_marcas_propias" name="model_id"/>
            <field name="domain_force">[('user_id','=',user.id)]</field>
            <field name="groups" eval="[(4, ref('group_proveedores_marcas_user'))]"/>
        </record>
    </data>
</odoo>
