    <record id="method_minori.report_venta_action" model="ir.actions.act_window">
        <field name="name">Ventas por marca</field>
        <field name="res_model">method_minori.ventas_report_marcas</field>
        <field name="view_mode">pivot,graph,tree</field>
        <field name="search_view_id" ref="method_minori.venta_report_search"/>
        <!-- <field name="context">{'search_default_current':1, 'search_default_supplier': 1, 'group_by':['invoice_date'], 'group_by_no_leaf':1}</field>
        <field name="search_view_id" ref="view_account_invoice_report_search"/> -->
