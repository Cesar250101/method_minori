    </record>


    <record id="method_minori.report_venta_marcas_propias_action_report" model="ir.actions.act_window">
            <field name="name">Ventas marcas propias y externas</field>
            <field name="res_model">method_minori.report_marcas_propias</field>
            <field name="view_mode">pivot,graph</field>
            <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No hay registros!</p>
          <p>Para ver el reporte necesita tener algunos datos.</p>
         </field>
    </record>
  

    <menuitem
        id="menu_stock_report_root"
        name="Informes Marcas"/>

    <menuitem
        id="method_minori.menu_informes"
        name="Informes"
        parent="menu_stock_report_root"
        sequence="2"/>

    <menuitem
        id="method_minori.stock_marca_id"
        name="Stock por Marca"
        action="method_minori.report_stock_action"
        parent="method_minori.menu_informes"
        sequence="2"/>

    <menuitem
        id="method_minori.informe_ventas"
        name="Ventas por Marca"
        action="method_minori.report_venta_action"
        parent="method_minori.menu_informes"
        sequence="3"/>

    <menuitem
        id="method_minori.informe_cierre_menu"
        name="Informes de Cierre"
        parent="method_minori.menu_informes"
        groups="method_minori.group_proveedores_marcas"
        sequence="1"/>

